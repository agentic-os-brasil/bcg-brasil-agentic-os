name: release candidate (disabled)

on:
  workflow_dispatch:
    inputs:
      version:
        description: Immutable MAJOR.MINOR.PATCH candidate version
        required: true
        type: string
      channel:
        description: Candidate channel
        required: true
        default: canary
        type: choice
        options:
          - canary
          - beta
          - stable

permissions:
  contents: read

jobs:
  validate-source:
    name: validate source snapshot
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version-file: go.mod
          cache: true
      - name: Validate source snapshot
        run: go run ./dev/harness validate --full

  build-native:
    name: native ${{ matrix.os }}/${{ matrix.arch }}
    needs: validate-source
    env:
      RELEASE_VERSION: ${{ inputs.version }}
      TARGET_OS: ${{ matrix.os }}
      TARGET_ARCH: ${{ matrix.arch }}
      TARGET_SUFFIX: ${{ matrix.suffix }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows
            arch: amd64
            runner: windows-2025
            suffix: .exe
          - os: darwin
            arch: amd64
            runner: macos-15-intel
            suffix: ""
          - os: darwin
            arch: arm64
            runner: macos-15
            suffix: ""
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version-file: go.mod
          cache: true
      - name: Build native Windows candidate binary
        if: matrix.os == 'windows'
        shell: pwsh
        run: >-
          go run ./dev/release binary
          --version "$env:RELEASE_VERSION"
          --os "$env:TARGET_OS"
          --arch "$env:TARGET_ARCH"
          --output "dist/native/bcgos_${env:RELEASE_VERSION}_${env:TARGET_OS}_${env:TARGET_ARCH}${env:TARGET_SUFFIX}"
      - name: Build native macOS candidate binary
        if: matrix.os == 'darwin'
        shell: bash
        run: >-
          go run ./dev/release binary
          --version "$RELEASE_VERSION"
          --os "$TARGET_OS"
          --arch "$TARGET_ARCH"
          --output "dist/native/bcgos_${RELEASE_VERSION}_${TARGET_OS}_${TARGET_ARCH}${TARGET_SUFFIX}"
      - name: Smoke-test native macOS candidate binary
        if: matrix.os == 'darwin'
        shell: bash
        run: |
          binary="dist/native/bcgos_${RELEASE_VERSION}_${TARGET_OS}_${TARGET_ARCH}${TARGET_SUFFIX}"
          chmod +x "$binary"
          output=$("$binary" version)
          test "$output" = "bcgos $RELEASE_VERSION"
      - name: Smoke-test native Windows candidate binary
        if: matrix.os == 'windows'
        shell: pwsh
        run: |
          $binary = "dist/native/bcgos_${env:RELEASE_VERSION}_${env:TARGET_OS}_${env:TARGET_ARCH}${env:TARGET_SUFFIX}"
          $output = (& $binary version | Out-String).Trim()
          if ($LASTEXITCODE -ne 0 -or $output -ne "bcgos $env:RELEASE_VERSION") {
            throw "Native Windows candidate did not report the requested version."
          }
      - name: Record native binary provenance
        shell: bash
        if: matrix.os == 'darwin'
        run: >-
          go run ./dev/release provenance
          --version "$RELEASE_VERSION"
          --binary "dist/native/bcgos_${RELEASE_VERSION}_${TARGET_OS}_${TARGET_ARCH}${TARGET_SUFFIX}"
          --os "$TARGET_OS"
          --arch "$TARGET_ARCH"
      - name: Record native binary provenance
        shell: pwsh
        if: matrix.os == 'windows'
        run: >-
          go run ./dev/release provenance
          --version "$env:RELEASE_VERSION"
          --binary "dist/native/bcgos_${env:RELEASE_VERSION}_${env:TARGET_OS}_${env:TARGET_ARCH}${env:TARGET_SUFFIX}"
          --os "$env:TARGET_OS"
          --arch "$env:TARGET_ARCH"
      - name: Upload native candidate binary
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: maestro-native-${{ matrix.os }}-${{ matrix.arch }}
          path: dist/native/
          if-no-files-found: error
          retention-days: 7

  assemble-candidate:
    name: assemble deterministic unsigned candidate
    needs:
      - validate-source
      - build-native
    runs-on: ubuntu-latest
    env:
      RELEASE_VERSION: ${{ inputs.version }}
      RELEASE_CHANNEL: ${{ inputs.channel }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version-file: go.mod
          cache: true
      - name: Download native candidate binaries
        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53 # v6
        with:
          pattern: maestro-native-*
          path: dist/native
          merge-multiple: true
      - name: Assemble candidate
        run: >-
          go run ./dev/release candidate
          --version "$RELEASE_VERSION"
          --channel "$RELEASE_CHANNEL"
          --prebuilt dist/native
          --output dist/release-candidate
      - name: Verify candidate closure
        run: go run ./dev/release verify --directory dist/release-candidate
      - name: Upload unsigned candidate
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: maestro-${{ inputs.version }}-${{ inputs.channel }}-unsigned
          path: dist/release-candidate/
          if-no-files-found: error
          retention-days: 7
      - name: Upload native build provenance
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: maestro-${{ inputs.version }}-${{ inputs.channel }}-build-provenance
          path: dist/native/*.provenance.json
          if-no-files-found: error
          retention-days: 7
