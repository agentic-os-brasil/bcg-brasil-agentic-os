<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bcg.maestro.maintenance</string>
  <key>Disabled</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>{{BCGOS_BIN}}</string>
    <string>maintenance</string>
    <string>wake</string>
    <string>--trigger</string>
    <string>presence</string>
    <string>--idle-state</string>
    <string>unknown</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{DIAGNOSTICS_DIR}}/maestro-maintenance.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{DIAGNOSTICS_DIR}}/maestro-maintenance.stderr.log</string>
</dict>
</plist>
