{
  "$schema": "https://claude.ai/schemas/settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/first-run-scaffold.sh\"" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-memory-inject.sh\"" }
        ]
      }
    ],
    "SessionStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-stop-dream.sh\"" }
        ]
      }
    ]
  }
}
