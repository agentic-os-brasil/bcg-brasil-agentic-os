{
  "schema_version": 1,
  "hub": "maestro",
  "delegation": {
    "mode": "role_gated_chains",
    "registered_chains": "governed_unbounded",
    "max_active_branches": 1,
    "max_depth": 2,
    "max_children_per_agent": 1,
    "max_errand_helpers": 1,
    "errand_scope": "basic_reversible",
    "allowed_edges": [
      {
        "from_role": "case_agent",
        "to_roles": ["capability_specialist"]
      },
      {
        "from_role": "hub",
        "to_roles": ["case_agent", "client_account_agent", "errand_helper", "governance_analyst", "pa_expert", "reviewer"]
      }
    ]
  },
  "legacy_aliases": {
    "account_agent": {"canonical_role": "client_account_agent", "status": "compatibility_only"},
    "workspace_agent": {"canonical_role": "case_agent", "status": "compatibility_only"},
    "practice_agent": {"canonical_role": "pa_expert", "status": "deprecated_rejected", "migration": "re-register as pa_expert with expert_kind FPA or IPA"},
    "subject_specialist": {"canonical_role": "pa_expert", "status": "deprecated_rejected", "migration": "re-register as pa_expert with expert_kind FPA or IPA"}
  },
  "legacy_ids": {
    "practice-agent-": {"canonical_role": "pa_expert", "status": "deprecated_rejected", "migration": "re-register as pa-expert-{fpa|ipa}-{scope}"},
    "subject-": {"canonical_role": "pa_expert", "status": "deprecated_rejected", "migration": "re-register as pa-expert-{fpa|ipa}-{scope}"}
  },
  "agents": [
    {
      "id": "darwin",
      "role": "governance_analyst",
      "direct_user_access": false,
      "tool_access": "scoped",
      "may_delegate": false,
      "input_contract": "bounded_health_packet",
      "relative_path": "agents/darwin/AGENT.md",
      "display_name": "Darwin",
      "default_emoji": "🧬",
      "ownership_scope": "governance",
      "customizable": true
    },
    {
      "id": "maestro",
      "role": "hub",
      "direct_user_access": true,
      "tool_access": "none",
      "may_delegate": true,
      "input_contract": "session_context_packet",
      "relative_path": "agents/maestro/AGENT.md",
      "display_name": "Maestro",
      "default_emoji": "🎼",
      "ownership_scope": "system",
      "customizable": true
    },
    {
      "id": "walter",
      "role": "reviewer",
      "direct_user_access": false,
      "tool_access": "none",
      "may_delegate": false,
      "input_contract": "sealed_review_packet",
      "relative_path": "agents/walter/AGENT.md",
      "display_name": "Walter",
      "default_emoji": "🦉",
      "ownership_scope": "governance",
      "customizable": true
    }
  ]
}
