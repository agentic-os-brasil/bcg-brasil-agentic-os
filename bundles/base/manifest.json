{
  "schema_version": 1,
  "bundle_id": "maestro-base",
  "bundle_version": "0.1.8",
  "format": "okf-1",
  "provenance": {
    "publisher": "BCG Brasil Agentic OS",
    "canonical_source": "bundles/base/",
    "distribution_map": "bundles/base/distribution.json",
    "status": "experimental",
    "status_note": "OKF-1 shape is not yet fixed. Downstream consumers should treat this manifest as forward-compatible-only: read known fields, ignore unknown ones. Breaking changes will bump schema_version and land with a migration note in the release provider."
  },
  "runtime_requirements": {
    "host": [
      "claude-code",
      "codex-cli"
    ],
    "hooks": [
      {
        "event": "session_start",
        "installer_path": ".claude/hooks/first-run-scaffold.sh",
        "criticality": "required"
      },
      {
        "event": "session_start",
        "installer_path": ".claude/hooks/session-start-memory-inject.sh",
        "criticality": "required"
      },
      {
        "event": "user_prompt_submit",
        "installer_path": ".claude/hooks/context-inject-userprompt.sh",
        "criticality": "recommended"
      },
      {
        "event": "pre_tool_use",
        "installer_path": ".claude/hooks/block-cross-case-writes.sh",
        "matcher": "Edit|Write",
        "criticality": "recommended"
      },
      {
        "event": "session_end",
        "installer_path": ".claude/hooks/session-stop-dream.sh",
        "criticality": "recommended"
      }
    ],
    "workspace_state": {
      "root": "data/",
      "owned_by": "user",
      "never_overwritten_by_upgrade": true,
      "version_markers": [
        "data/.maestro-version",
        "data/memory/.schema-version"
      ]
    }
  },
  "contracts": {
    "memory_policy": "bundles/base/memory/policy.json",
    "profile_policy": "bundles/base/profile/policy.json",
    "runtime_capabilities": "bundles/base/runtime/capabilities.json",
    "runtime_maintenance": "bundles/base/runtime/maintenance.json",
    "release_provider": "bundles/base/release/provider.json"
  },
  "agents": [
    "bundles/base/agents/case-agent/AGENT.md",
    "bundles/base/agents/client-account-agent/AGENT.md",
    "bundles/base/agents/darwin/AGENT.md",
    "bundles/base/agents/gamma-guardian/AGENT.md",
    "bundles/base/agents/maestro/AGENT.md",
    "bundles/base/agents/pa-expert/AGENT.md",
    "bundles/base/agents/walter/AGENT.md"
  ],
  "agent_templates": [
    "bundles/base/agents/templates/account_agent/AGENT.md",
    "bundles/base/agents/templates/case_agent/AGENT.md",
    "bundles/base/agents/templates/client_account_agent/AGENT.md",
    "bundles/base/agents/templates/pa_expert/AGENT.md",
    "bundles/base/agents/templates/practice_agent/AGENT.md",
    "bundles/base/agents/templates/quality_guardian/AGENT.md",
    "bundles/base/agents/templates/subject_specialist/AGENT.md",
    "bundles/base/agents/templates/workspace_agent/AGENT.md"
  ],
  "skills_index": "bundles/base/skills/INDEX.md",
  "skills_catalog": "bundles/base/skills/catalog.json",
  "control_plane_skills": {
    "operator": "bundles/base/skills/maestro-operator/SKILL.md",
    "doctor": "bundles/base/skills/maestro-doctor/SKILL.md",
    "setup_update": "bundles/base/skills/maestro-setup-update/SKILL.md",
    "onboarding": "bundles/base/skills/maestro-onboarding/SKILL.md",
    "dream_memory": "bundles/base/skills/dream-memory/SKILL.md"
  },
  "schemas": {
    "root": "schemas/",
    "referenced_by": [
      "bundles/base/memory/policy.json",
      "bundles/base/profile/policy.json",
      "bundles/base/runtime/capabilities.json",
      "bundles/base/skills/maestro-onboarding/SKILL.md"
    ],
    "profile_outputs": {
      "purpose": "Maps the four user-facing profile files produced by the maestro-onboarding skill to their declarative JSON Schemas. Consumers validating data/profile/ contents (installer, harness validators, downstream OKF bundlers) should look them up here rather than walking the tree. Schemas mirror the manifest's provenance.status=experimental stance; shape may evolve.",
      "data/profile/identity.json": "schemas/identity.schema.json",
      "data/profile/style.json": "schemas/style.schema.json",
      "data/profile/onboarding.json": "schemas/onboarding.schema.json",
      "data/profile/markitdown.json": "schemas/markitdown.schema.json"
    }
  },
  "portability_notes": {
    "purpose": "Portable manifest describing how the bundle plugs into a Claude/Codex host without leaking managed-root paths. Consumers read this file to discover hooks, contracts, agents and skills without walking the tree.",
    "consumers": [
      "installer",
      "harness validators",
      "downstream OKF bundlers"
    ],
    "invariants": [
      "bundle never writes outside data/ inside the user's workspace",
      "version_markers live inside data/ so upgrades are detectable but reversible",
      "hooks are fail-open and idempotent"
    ]
  }
}
