{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:workspace-import-journal:v1",
  "title": "Maestro workspace import durable commit journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_id", "plan_digest", "state", "recorded_at", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run-[a-f0-9]{16}$"},
    "plan_id": {"type": "string", "pattern": "^wimp-[a-f0-9]{16}$"},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["prepared", "committing", "failed", "reconciled"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "committed": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "stage_path", "destination_path", "action", "content_digest"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "stage_path": {"type": "string", "minLength": 1},
        "destination_path": {"type": "string", "minLength": 1},
        "action": {"enum": ["copy", "quarantine"]},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
