{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:execution-state:v1",
  "title": "Maestro Execution Ledger V1",
  "oneOf": [
    {"$ref": "#/$defs/contract"},
    {"$ref": "#/$defs/revision"},
    {"$ref": "#/$defs/state"},
    {"$ref": "#/$defs/attempt"},
    {"$ref": "#/$defs/transition"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["artifact_snapshot", "command_check"]}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "item_id",
        "workspace_id",
        "authority_kind",
        "objective",
        "initial_next_step",
        "criteria",
        "allowed_refs",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "authority_kind": {"const": "local_execution"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
        "initial_next_step": {"type": "string", "minLength": 1, "maxLength": 2048},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        },
        "allowed_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bcgos://[A-Za-z0-9/_-]+$"
          }
        },
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "item_id",
        "workspace_id",
        "state",
        "state_revision",
        "contract_version",
        "contract_sha256",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "state": {
          "enum": ["ready", "running", "paused", "evaluating", "completed", "cancelled"]
        },
        "state_revision": {"type": "integer", "minimum": 1},
        "contract_version": {"const": 1},
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "active_attempt_id": {"$ref": "#/$defs/id"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "item_id",
        "workspace_id",
        "state",
        "started_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "attempt_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "state": {"enum": ["active", "interrupted", "completed", "cancelled"]},
        "started_at": {"type": "string", "format": "date-time"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "item_id",
        "workspace_id",
        "state",
        "state_revision",
        "occurred_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "state": {
          "enum": ["ready", "running", "paused", "evaluating", "completed", "cancelled"]
        },
        "state_revision": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "transition"],
      "properties": {
        "schema_version": {"const": 1},
        "state": {"$ref": "#/$defs/state"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "transition": {"$ref": "#/$defs/transition"}
      }
    }
  }
}
