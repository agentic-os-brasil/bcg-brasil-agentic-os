{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:execution-state:v1",
  "title": "Maestro Execution Ledger V1",
  "oneOf": [
    {"$ref": "#/$defs/contract"},
    {"$ref": "#/$defs/revision"},
    {"$ref": "#/$defs/state"},
    {"$ref": "#/$defs/attempt"},
    {"$ref": "#/$defs/checkpoint"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/tool_call"},
    {"$ref": "#/$defs/walter_review"},
    {"$ref": "#/$defs/transition"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "target_ref"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "type": {"const": "artifact_snapshot"},
            "target_ref": {
              "type": "string",
              "pattern": "^bcgos://workspace/[A-Za-z0-9/_.-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "command"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "type": {"const": "command_check"},
            "command": {
              "oneOf": [
                {"const": ["go", "version"]},
                {"const": ["go", "test", "./..."]},
                {"const": ["go", "vet", "./..."]}
              ]
            }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "item_id",
        "workspace_id",
        "authority_kind",
        "objective",
        "initial_next_step",
        "criteria",
        "allowed_refs",
        "require_walter_review",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "authority_kind": {"const": "local_execution"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
        "initial_next_step": {"type": "string", "minLength": 1, "maxLength": 2048},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        },
        "allowed_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bcgos://[A-Za-z0-9/_.-]+$"
          }
        },
        "require_walter_review": {"type": "boolean"},
        "walter_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "walter_key_id": {
          "$ref": "#/$defs/id"
        },
        "walter_installation_id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"require_walter_review": {"const": true}},
            "required": ["require_walter_review"]
          },
          "then": {"required": ["walter_public_key", "walter_key_id", "walter_installation_id"]},
          "else": {
            "allOf": [
              {"not": {"required": ["walter_public_key"]}},
              {"not": {"required": ["walter_key_id"]}},
              {"not": {"required": ["walter_installation_id"]}}
            ]
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "item_id",
        "workspace_id",
        "state",
        "state_revision",
        "contract_version",
        "contract_sha256",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "state": {
          "enum": ["ready", "running", "paused", "evaluating", "completed", "cancelled"]
        },
        "state_revision": {"type": "integer", "minimum": 1},
        "contract_version": {"const": 1},
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "active_attempt_id": {"$ref": "#/$defs/id"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "item_id",
        "workspace_id",
        "state",
        "started_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "attempt_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "state": {"enum": ["active", "interrupted", "completed", "cancelled"]},
        "started_at": {"type": "string", "format": "date-time"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checkpoint_id",
        "item_id",
        "workspace_id",
        "attempt_id",
        "summary",
        "next_step",
        "artifact_refs",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "checkpoint_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 768},
        "next_step": {"type": "string", "minLength": 1, "maxLength": 768},
        "blocker": {"type": "string", "maxLength": 256},
        "artifact_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^bcgos://[A-Za-z0-9/_.-]+$"
          }
        },
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "item_id",
        "workspace_id",
        "state",
        "state_revision",
        "occurred_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "state": {
          "enum": ["ready", "running", "paused", "evaluating", "completed", "cancelled"]
        },
        "state_revision": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "evidence_id", "item_id", "workspace_id",
            "attempt_id", "criterion_id", "type", "outcome", "target_ref",
            "artifact_sha256", "artifact_bytes", "observed_at"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "evidence_id": {"$ref": "#/$defs/id"},
            "item_id": {"$ref": "#/$defs/id"},
            "workspace_id": {"$ref": "#/$defs/workspace_id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "criterion_id": {"$ref": "#/$defs/id"},
            "type": {"const": "artifact_snapshot"},
            "outcome": {"enum": ["passed", "failed"]},
            "target_ref": {
              "type": "string",
              "pattern": "^bcgos://workspace/[A-Za-z0-9/_.-]+$"
            },
            "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "artifact_bytes": {"type": "integer", "minimum": 0},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "evidence_id", "item_id", "workspace_id",
            "attempt_id", "criterion_id", "type", "outcome",
            "command_sha256", "tool_sha256", "exit_code", "observed_at"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "evidence_id": {"$ref": "#/$defs/id"},
            "item_id": {"$ref": "#/$defs/id"},
            "workspace_id": {"$ref": "#/$defs/workspace_id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "criterion_id": {"$ref": "#/$defs/id"},
            "type": {"const": "command_check"},
            "outcome": {"enum": ["passed", "failed"]},
            "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "tool_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "exit_code": {"type": "integer"},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "tool_call_id", "item_id", "workspace_id",
        "attempt_id", "agent_id", "tool_id", "state", "started_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "tool_call_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "agent_id": {"enum": ["claude", "codex", "maestro-core"]},
        "tool_id": {
          "enum": [
            "browser", "filesystem-read", "filesystem-write", "git", "github",
            "other", "shell", "skill", "subagent", "web"
          ]
        },
        "state": {"enum": ["started", "succeeded", "failed", "unavailable"]},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "started"}}},
          "then": {"not": {"required": ["finished_at"]}},
          "else": {"required": ["finished_at"]}
        }
      ]
    },
    "walter_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "review_id", "item_id", "workspace_id",
        "attempt_id", "reviewed_revision", "recorded_revision",
        "contract_sha256", "signer_key_id", "installation_id", "custody_scope",
        "decision", "signer_sha256",
        "envelope_sha256", "observed_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "review_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "reviewed_revision": {"type": "integer", "minimum": 1},
        "recorded_revision": {"type": "integer", "minimum": 2},
        "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signer_key_id": {"$ref": "#/$defs/id"},
        "installation_id": {"$ref": "#/$defs/id"},
        "custody_scope": {"const": "maestro/walter-review"},
        "decision": {"enum": ["approved", "rejected"]},
        "signer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "envelope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "state", "transition"],
      "allOf": [
        {"not": {"required": ["evidence", "tool_call"]}},
        {"not": {"required": ["evidence", "walter_review"]}},
        {"not": {"required": ["tool_call", "walter_review"]}}
      ],
      "properties": {
        "schema_version": {"const": 1},
        "state": {"$ref": "#/$defs/state"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "tool_call": {"$ref": "#/$defs/tool_call"},
        "walter_review": {"$ref": "#/$defs/walter_review"},
        "transition": {"$ref": "#/$defs/transition"}
      }
    }
  }
}
