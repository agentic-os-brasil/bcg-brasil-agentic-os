{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcgos.local/schemas/walter-self-review.schema.json",
  "title": "Walter weekly self-review metadata receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "state", "week_id", "idempotency_key", "input_sha256", "prompt_window_sha256", "canonical_snapshot_version", "canonical_snapshot_sha256", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string"},
    "state": {"enum": ["proposed", "duplicate", "unavailable", "rejected"]},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9_-]{1,96}$"},
    "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "idempotency_key": {"type": "string"},
    "input_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "prompt_window_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "canonical_snapshot_version": {"type": "integer", "minimum": 1},
    "canonical_snapshot_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "observation_digests": {"type": "array", "maxItems": 32, "items": {"$ref": "execution-state.schema.json#/$defs/sha256"}},
    "proposal_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "adapter_id": {"type": "string"},
    "authority_id": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
