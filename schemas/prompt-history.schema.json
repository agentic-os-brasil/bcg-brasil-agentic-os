{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os-brasil/schemas/prompt-history.schema.json",
  "title": "Owner-local PromptHistoryStore",
  "description": "Private user prompt history only. It is never a managed, telemetry, receipt, federation or release surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "owner_id", "recorded_at", "language", "source", "session_id", "scope_kind", "scope_id", "sha256", "content_kind", "prompt"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "occurrence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{2,8})?$"},
    "source": {"enum": ["claude", "codex", "cli", "owner"]},
    "session_id": {"type": "string", "minLength": 1},
    "scope_kind": {"enum": ["global", "workspace", "account", "case"]},
    "scope_id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_kind": {"const": "user_prompt"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 65536}
  }
}
