{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:memory-commit:v1",
  "title": "BCG Brasil Agentic OS memory commit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "transaction_id", "committed_at", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "transaction_id": {"type": "string", "pattern": "^dream-[A-Za-z0-9]+$"},
    "parent_commit": {"type": "string", "minLength": 1},
    "committed_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(L1/[0-9]{4}-[0-9]{2}-[0-9]{2}|L2/[0-9]{4}-W[0-9]{2}|L3/current|lifetime/current)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^versions/dream-[A-Za-z0-9]+/[0-9]{2}-(l1|l2|l3|lifetime)-[^/]+[.]json$"
      }
    }
  }
}
