{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:portable-skill-manifest:v1",
  "title": "Maestro born-portable skill manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "origin": { "const": "born_portable" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generalizable": { "const": true }
  },
  "required": ["schema_version", "skill_id", "version", "origin", "content_sha256", "generalizable"]
}
