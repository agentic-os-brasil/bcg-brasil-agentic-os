{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcgos.local/schemas/yoda-self-review.schema.json",
  "title": "Yoda weekly self-review metadata receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "state", "week_id", "occurrence_id", "fencing_token", "lease_owner", "lease_until", "request_sha256", "prompt_history_sha256", "translation_receipt_sha256", "canonical_snapshot_sha256", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["reserved", "proposal_emitted", "unavailable", "failed"]},
    "week_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "occurrence_id": {"type": "string", "minLength": 1},
    "fencing_token": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "lease_owner": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "lease_until": {"type": "string", "format": "date-time"},
    "request_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "prompt_history_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "translation_receipt_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "canonical_snapshot_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "proposal_id": {"type": "string"},
    "proposal_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "ownerctx_proposal_id": {"type": "string"},
    "ownerctx_proposal_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "ownerctx_policy": {"type": "string"},
    "canonical_sensitivity": {"type": "string"},
    "canonical_readers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "canonical_refinement": {"type": "string"},
    "canonical_confirmation_requirement": {"enum": ["automatic_with_audit", "proposal_only", "confirmation_required"]},
    "adapter_id": {"type": "string"},
    "authority_id": {"type": "string"},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9_-]{1,96}$"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
