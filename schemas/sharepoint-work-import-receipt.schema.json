{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-import-receipt:v1",
  "title": "Maestro SharePoint work import receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "capability",
    "producer_runtime",
    "outcome",
    "emitted_at",
    "tenant_ref",
    "roots",
    "collection_sequence",
    "watermark",
    "snapshot_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_class": {"const": "adapter_command"},
    "capability": {"const": "sharepoint_work_collection"},
    "producer_runtime": {"const": "claude"},
    "outcome": {"const": "succeeded"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "tenant_ref": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/opaque_ref"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/root"},
      "uniqueItems": true
    },
    "collection_sequence": {"type": "integer", "minimum": 1},
    "watermark": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/watermark"},
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
