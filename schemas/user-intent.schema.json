  "$defs": {
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "snapshot": {"type":"object","additionalProperties":false,"required":["schema_version","version","digest","owner","projection_of","precedence_policy","sections"],"properties":{"schema_version":{"const":1},"version":{"type":"integer","minimum":1},"digest":{"$ref":"#/$defs/digest"},"owner":{"const":"user"},"projection_of":{"const":"owner_context"},"precedence_policy":{"const":["explicit_instruction","explicit_correction","canonical_snapshot","recent_observation","walter_hypothesis"]},"sections":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["preferences","principles","decision_rules","communication_style","motivations","boundaries"]}}}},
    "observation_ref": {"type":"object","additionalProperties":false,"required":["observation_id","source_event_sha256","kind","scope","confidence"],"properties":{"observation_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"source_event_sha256":{"$ref":"#/$defs/digest"},"kind":{"enum":["explicit_instruction","explicit_correction","explicit_endorsement","observed_pattern","inferred_hypothesis"]},"scope":{"enum":["global","workspace","account","case","interaction","skill"]},"confidence":{"enum":["low","medium","high"]}}},
    "self_review_packet": {"type":"object","additionalProperties":false,"required":["schema_version","packet_id","prompt_literal","prompt_sha256","plan_route","plan_sha256","draft_output","draft_sha256","user_self_snapshot","audience","consequence","reversibility"],"properties":{"schema_version":{"const":1},"packet_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"prompt_literal":{"type":"string","minLength":1,"maxLength":32768},"prompt_sha256":{"$ref":"#/$defs/digest"},"plan_route":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:/-]{0,127}$"},"plan_sha256":{"$ref":"#/$defs/digest"},"draft_output":{"type":"string","minLength":1,"maxLength":32768},"draft_sha256":{"$ref":"#/$defs/digest"},"context_refs":{"type":"array","maxItems":12,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:/-]{0,127}$"}},"user_self_snapshot":{"$ref":"#/$defs/snapshot"},"observations":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/observation_ref"}},"account_receipt_sha256":{"$ref":"#/$defs/digest"},"audience":{"enum":["user","internal","client","executive","external"]},"consequence":{"enum":["low","material","high"]},"reversibility":{"enum":["reversible","hard_to_reverse"]}}},
    "intent_review": {"type":"object","additionalProperties":false,"required":["schema_version","literal_request","intrinsic_intent_hypothesis","evidence_refs","confidence","materiality","disconfirmation_condition","purpose_satisfied","verdict"],"properties":{"schema_version":{"const":1},"literal_request":{"type":"string","minLength":1,"maxLength":32768},"intrinsic_intent_hypothesis":{"type":"object","additionalProperties":false,"required":["text","confidence","status"],"properties":{"text":{"type":"string","minLength":1,"maxLength":4000},"confidence":{"enum":["low","medium","high"]},"status":{"const":"hypothesis"}}},"evidence_refs":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:/-]{0,127}$"}},"confidence":{"enum":["low","medium","high"]},"alternatives":{"type":"array","maxItems":4,"items":{"type":"string","minLength":1,"maxLength":4000}},"materiality":{"enum":["low","material","high"]},"disconfirmation_condition":{"type":"string","minLength":1,"maxLength":4000},"purpose_satisfied":{"enum":["yes","partial","no","unknown"]},"constructive_refinement":{"type":"object","additionalProperties":false,"required":["kind","summary","acceptance_criteria","preserves_intent","load_bearing","blocking"],"properties":{"kind":{"enum":["purpose","preference","decision_rule","communication","readiness","governance_blocker"]},"summary":{"type":"string","minLength":1},"acceptance_criteria":{"type":"string","minLength":1},"preserves_intent":{"type":"boolean"},"load_bearing":{"type":"boolean"},"blocking":{"type":"boolean"}}},"unresolved_uncertainty":{"type":"string","maxLength":4000},"verdict":{"enum":["approve","refine","clarify","hold_exceptional"]}}},
    "intent_review_receipt": {"type":"object","additionalProperties":false,"required":["schema_version","review_id","packet_id","packet_sha256","prompt_sha256","draft_sha256","self_snapshot_version","self_snapshot_sha256","verdict","purpose_satisfied","confidence","reviewer_id","cycle","recorded_at"],"properties":{"schema_version":{"const":1},"review_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"packet_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"packet_sha256":{"$ref":"#/$defs/digest"},"prompt_sha256":{"$ref":"#/$defs/digest"},"draft_sha256":{"$ref":"#/$defs/digest"},"self_snapshot_version":{"type":"integer","minimum":1},"self_snapshot_sha256":{"$ref":"#/$defs/digest"},"verdict":{"enum":["approve","refine","clarify","hold_exceptional"]},"purpose_satisfied":{"enum":["yes","partial","no","unknown"]},"confidence":{"enum":["low","medium","high"]},"reviewer_id":{"const":"walter"},"cycle":{"type":"integer","minimum":0},"recorded_at":{"type":"string","format":"date-time"}}},
    "interaction_observation": {"type":"object","additionalProperties":false,"required":["schema_version","observation_id","source_event_sha256","kind","facet","signal_key","claim_digest","episode_sha256","evidence_type","owner_authenticated","material","declassified","scope","confidence_basis_points","sensitivity","lifecycle","recorded_at","expires_at","recheck_at","user_confirmed"],"properties":{"schema_version":{"const":1},"observation_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"source_event_sha256":{"$ref":"#/$defs/digest"},"kind":{"enum":["explicit_instruction","explicit_correction","explicit_endorsement","observed_pattern","inferred_hypothesis"]},"facet":{"enum":["preferences","principles","decision_rules","communication_style","motivations","boundaries"]},"signal_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:/-]{0,127}$"},"claim_digest":{"$ref":"#/$defs/digest"},"episode_sha256":{"$ref":"#/$defs/digest"},"evidence_type":{"enum":["owner_speech","owner_action"]},"owner_authenticated":{"const":true},"material":{"const":true},"declassified":{"type":"boolean"},"scope":{"enum":["global","workspace","account","case","interaction","skill"]},"confidence_basis_points":{"type":"integer","minimum":0,"maximum":10000},"sensitivity":{"enum":["normal","sensitive","restricted"]},"lifecycle":{"enum":["captured","eligible","corroborated","rejected","contradicted","expired"]},"recorded_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"recheck_at":{"type":"string","format":"date-time"},"user_confirmed":{"type":"boolean"},"supersedes_ids":{"type":"array","items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"uniqueItems":true}}},
