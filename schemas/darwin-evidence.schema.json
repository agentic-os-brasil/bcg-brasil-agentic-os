{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os-brasil.example/schemas/darwin-evidence.schema.json",
  "title": "Maestro Darwin metadata-only evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_id", "window_id", "scope_sha256", "evidence_authority", "recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["health", "selection", "proposal", "acceptance", "evaluation", "alternative", "maestro_flow", "self_loop"]},
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"},
    "window_id": {"type": "string", "pattern": "^win-[a-f0-9]{32}$"},
    "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_authority": {"const": "caller_asserted_shadow"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "health": {"$ref": "#/$defs/health"},
    "selection": {"$ref": "#/$defs/selection"},
    "proposal": {"$ref": "#/$defs/proposal"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "alternative": {"$ref": "#/$defs/alternative"},
    "flow": {"$ref": "#/$defs/flow"},
    "self": {"$ref": "#/$defs/self"}
  },
  "oneOf": [
    {"required": ["health"], "properties": {"kind": {"const": "health"}}, "not": {"anyOf": [{"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}]}},
    {"required": ["selection"], "properties": {"kind": {"const": "selection"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}]}},
    {"required": ["proposal"], "properties": {"kind": {"const": "proposal"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}]}},
    {"required": ["acceptance"], "properties": {"kind": {"const": "acceptance"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}]}},
    {"required": ["evaluation"], "properties": {"kind": {"const": "evaluation"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["alternative"]}]}},
    {"required": ["alternative"], "properties": {"kind": {"const": "alternative"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["flow"]}]}},
    {"required": ["flow"], "properties": {"kind": {"const": "maestro_flow"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}, {"required": ["self"]}]}},
    {"required": ["self"], "properties": {"kind": {"const": "self_loop"}}, "not": {"anyOf": [{"required": ["health"]}, {"required": ["selection"]}, {"required": ["proposal"]}, {"required": ["acceptance"]}, {"required": ["evaluation"]}, {"required": ["alternative"]}, {"required": ["flow"]}]}}
  ],
  "$defs": {
    "health": {"type":"object","additionalProperties":false,"required":["job_kind","scheduled_at","captured_at","freshness","recovery","outcome"],"properties":{"job_kind":{"enum":["darwin_housekeeping","federation_weekly","activation_monitor"]},"scheduled_at":{"type":"string","format":"date-time"},"captured_at":{"type":"string","format":"date-time"},"freshness":{"enum":["current","aging","stale","missed","unavailable"]},"recovery":{"enum":["not_needed","recovered","failed","blocked"]},"outcome":{"enum":["succeeded","failed","blocked","unavailable","no_action","partial"]}}},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256","policy_version","posture","route","outcome","duration_seconds","max_calls","calls_used","max_token_units","token_units_used","budget_exhausted","human_override","override_kind","pa_coverage","pa_expert_count","capability_gaps"],
      "properties": {
        "plan_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
        "policy_version": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
        "posture": {"enum":["direct","balanced","deliberative"]},
        "route": {"enum":["D0_DIRECT","D1_TARGETED","D2_GOVERNED","BLOCKED"]},
        "outcome": {"enum":["succeeded","failed","blocked","unavailable","no_action","partial"]},
        "duration_seconds": {"type":"integer","minimum":0,"maximum":86400},
        "max_calls": {"type":"integer","minimum":0,"maximum":6},
        "calls_used": {"type":"integer","minimum":0,"maximum":6},
        "max_token_units": {"type":"integer","minimum":0,"maximum":24000},
        "token_units_used": {"type":"integer","minimum":0,"maximum":24000},
        "budget_exhausted": {"type":"boolean"},
        "human_override": {"type":"boolean"},
        "override_kind": {"enum":["none","route_change","budget_extension","manual_resume","release_recovery"]},
        "pa_coverage": {"enum":["not_required","covered","missing","unavailable"]},
        "pa_expert_count": {"type":"integer","minimum":0,"maximum":2},
        "capability_gaps": {"type":"array","maxItems":8,"uniqueItems":true,"items":{"enum":["native_runtime","receipt_coverage","pa_expert_coverage","recovery","budget","latency","human_confirmation"]}}
      },
      "allOf": [
        {"if":{"properties":{"route":{"const":"D0_DIRECT"}}},"then":{"properties":{"max_calls":{"const":1},"calls_used":{"maximum":1},"max_token_units":{"const":4000},"token_units_used":{"maximum":4000},"pa_coverage":{"const":"not_required"},"pa_expert_count":{"const":0}}}},
        {"if":{"properties":{"route":{"const":"D1_TARGETED"}}},"then":{"properties":{"max_calls":{"const":3},"calls_used":{"maximum":3},"max_token_units":{"const":10000},"token_units_used":{"maximum":10000},"pa_expert_count":{"maximum":1}}}},
        {"if":{"properties":{"route":{"const":"D2_GOVERNED"}}},"then":{"properties":{"max_calls":{"const":6},"calls_used":{"maximum":6},"max_token_units":{"const":24000},"token_units_used":{"maximum":24000}}}},
        {"if":{"properties":{"route":{"const":"BLOCKED"}}},"then":{"properties":{"max_calls":{"const":0},"calls_used":{"const":0},"max_token_units":{"const":0},"token_units_used":{"const":0}}}},
        {"if":{"properties":{"human_override":{"const":false}}},"then":{"properties":{"override_kind":{"const":"none"}}}},
        {"if":{"properties":{"human_override":{"const":true}}},"then":{"not":{"properties":{"override_kind":{"const":"none"}}}}},
        {"if":{"properties":{"pa_coverage":{"enum":["not_required","missing","unavailable"]}}},"then":{"properties":{"pa_expert_count":{"const":0}}}},
        {"if":{"properties":{"pa_coverage":{"const":"covered"}}},"then":{"properties":{"pa_expert_count":{"minimum":1}}}}
      ]
    },
    "proposal": {"type":"object","additionalProperties":false,"required":["proposal_sha256","proposal_kind","status","author_role"],"properties":{"proposal_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"proposal_kind":{"enum":["policy_calibration","capability_improvement","reliability_fix","skill_pattern"]},"status":{"enum":["draft","accepted","rejected","deferred","implemented","rolled_back"]},"author_role":{"const":"darwin"}}},
    "acceptance": {"type":"object","additionalProperties":false,"required":["proposal_sha256","decision","actor_role"],"properties":{"proposal_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"enum":["accepted","rejected","deferred"]},"actor_role":{"const":"human_maintainer"}}},
    "evaluation": {"type":"object","additionalProperties":false,"required":["proposal_sha256","baseline_window_id","post_change_window_id","change_sha256","evaluator_role","outcome","self_evaluation"],"properties":{"proposal_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"baseline_window_id":{"type":"string","pattern":"^win-[a-f0-9]{32}$"},"post_change_window_id":{"type":"string","pattern":"^win-[a-f0-9]{32}$"},"change_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"evaluator_role":{"const":"independent_evaluator"},"outcome":{"enum":["improved","neutral","regressed","insufficient"]},"self_evaluation":{"const":false}}},
    "alternative": {"type":"object","additionalProperties":false,"required":["cohort_sha256","alternative_id","policy_version","posture","route","outcome","duration_seconds","budget_exhausted","pa_coverage","capability_gap_count"],"properties":{"cohort_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"alternative_id":{"enum":["baseline","candidate_a","candidate_b","candidate_c"]},"policy_version":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},"posture":{"enum":["direct","balanced","deliberative"]},"route":{"enum":["D0_DIRECT","D1_TARGETED","D2_GOVERNED","BLOCKED"]},"outcome":{"enum":["succeeded","failed","blocked","unavailable","no_action","partial"]},"duration_seconds":{"type":"integer","minimum":0,"maximum":86400},"budget_exhausted":{"type":"boolean"},"pa_coverage":{"enum":["not_required","covered","missing","unavailable"]},"capability_gap_count":{"type":"integer","minimum":0,"maximum":8}}},
    "flow": {"type":"object","additionalProperties":false,"required":["attempt_id","attempt_sha256","entry_path","pre_account_used","account_consultation_required","post_account_validation_required","post_account_validated","walter_required","walter_gate","walter_skipped","account_validation_count","walter_review_count","cycles","budget_exhausted","materiality_escalations","invalidations_after_mutation","return_to_walter_without_account_validation","material_finish_without_walter","one_active_spoke_violations","nesting_violations","direct_agent_calls","material_delivered"],"properties":{"attempt_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,63}$"},"attempt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"entry_path":{"enum":["account_first","case_direct"]},"pre_account_used":{"type":"boolean"},"account_consultation_required":{"type":"boolean"},"post_account_validation_required":{"type":"boolean"},"post_account_validated":{"type":"boolean"},"walter_required":{"type":"boolean"},"walter_gate":{"type":"boolean"},"walter_skipped":{"type":"boolean"},"account_validation_count":{"type":"integer","minimum":0},"walter_review_count":{"type":"integer","minimum":0},"cycles":{"type":"integer","minimum":0},"budget_exhausted":{"type":"boolean"},"materiality_escalations":{"type":"integer","minimum":0},"invalidations_after_mutation":{"type":"integer","minimum":0},"return_to_walter_without_account_validation":{"type":"integer","minimum":0},"material_finish_without_walter":{"type":"integer","minimum":0},"one_active_spoke_violations":{"type":"integer","minimum":0},"nesting_violations":{"type":"integer","minimum":0},"direct_agent_calls":{"type":"integer","minimum":0},"material_delivered":{"type":"boolean"},"account_signals":{"type":"array","items":{"enum":["client_strategy","relationship_positioning","stakeholder_pressure_test","client_material","cross_case_context","promotion_candidate","execution_only"]}},"walter_skip_reason":{"const":"low_leverage_ordinary_reversible_no_external_artifact"},"walter_skip_evidence_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"refinement_load_bearing":{"type":"boolean"},"refinement_actionable":{"type":"boolean"},"refinement_kind":{"enum":["clarity","narrative","recommendation","tradeoff","readiness","governance_blocker"]}}},
    "self": {"type":"object","additionalProperties":false,"required":["snapshot_version","snapshot_sha256","observation_count","duplicate_count","contradiction_count","recheck_due","decay_candidates","owner_confirmed_signals","reevaluation_proposals","canonical_mutations"],"properties":{"snapshot_version":{"type":"integer","minimum":1},"snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"observation_count":{"type":"integer","minimum":0},"duplicate_count":{"type":"integer","minimum":0},"contradiction_count":{"type":"integer","minimum":0},"recheck_due":{"type":"integer","minimum":0},"decay_candidates":{"type":"integer","minimum":0},"owner_confirmed_signals":{"type":"integer","minimum":0},"reevaluation_proposals":{"type":"integer","minimum":0},"canonical_mutations":{"const":0}}}
  }
}
