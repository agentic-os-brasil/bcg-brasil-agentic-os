{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:ingestion-runtime-pack:v1",
  "title": "Maestro MarkItDown ingestion runtime pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "version", "python_path", "script_path", "python_sha256", "script_sha256", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter": {"const": "markitdown"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "python_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "script_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "python_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {"const": "bcgos-managed-installer"}
  }
}
