{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:memory-checkpoint:v1",
  "title": "BCG Brasil Agentic OS metadata-only memory checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "revision",
    "provenance",
    "source_watermark_sha256",
    "source_count",
    "latest_source_job_id",
    "latest_source_at",
    "checkpointed_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "provenance": {"const": "scheduler_receipts_v1"},
    "source_watermark_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_count": {"type": "integer", "minimum": 1},
    "latest_source_job_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "latest_source_at": {"type": "string", "format": "date-time"},
    "checkpointed_at": {"type": "string", "format": "date-time"},
    "previous_checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
