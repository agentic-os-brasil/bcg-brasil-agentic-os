{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:maintenance-jobs:v1",
  "title": "BCG Brasil Agentic OS maintenance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_state", "jobs"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_state": {"enum": ["catalog_only", "runtime_qualified"]},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "trigger",
        "executor",
        "scope",
        "availability",
        "availability_reason",
        "default_enabled",
        "unattended",
        "writes",
        "success_boundary"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "category": {"enum": ["memory", "wiki", "runtime", "self", "update"]},
        "trigger": {"enum": ["presence", "daily", "weekly", "monthly", "event", "daily_or_presence", "weekly_or_presence", "monthly_or_presence", "bundle_update_or_presence", "lifecycle_cadence"]},
        "executor": {"enum": ["deterministic", "local_adapter", "model_adapter"]},
        "scope": {"enum": ["owner", "workspace", "managed"]},
        "availability": {"enum": ["available", "unavailable"]},
        "availability_reason": {"type": "string", "maxLength": 512},
        "default_enabled": {"type": "boolean"},
        "unattended": {"enum": ["deterministic_only", "policy_gated", "never"]},
        "writes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "oneOf": [
            {"const": ["none"]},
            {"items": {"enum": ["memory_l1", "memory_rollups", "memory_checkpoint", "wiki_private", "runtime_index", "owner_observation", "local_diagnostics", "source_custody", "candidate_plan", "derived_health_cache", "bounded_assessment"]}}
          ]
        },
        "success_boundary": {"type": "string", "minLength": 1, "maxLength": 512},
        "qualification_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "writes": {
                "contains": {
                  "enum": [
                    "derived_health_cache",
                    "bounded_assessment"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "enum": [
                  "darwin-housekeeping-daily",
                  "darwin-deep-weekly",
                  "darwin-structural-evolution-proposal"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "darwin-housekeeping-daily"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "runtime"
              },
              "trigger": {
                "const": "daily_or_presence"
              },
              "executor": {
                "const": "local_adapter"
              },
              "scope": {
                "const": "managed"
              },
              "unattended": {
                "const": "policy_gated"
              },
              "writes": {
                "const": [
                  "local_diagnostics",
                  "derived_health_cache"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "darwin-deep-weekly"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "runtime"
              },
              "trigger": {
                "const": "weekly_or_presence"
              },
              "executor": {
                "const": "local_adapter"
              },
              "scope": {
                "const": "managed"
              },
              "unattended": {
                "const": "policy_gated"
              },
              "writes": {
                "const": [
                  "local_diagnostics",
                  "derived_health_cache",
                  "bounded_assessment"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "darwin-structural-evolution-proposal"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "runtime"
              },
              "trigger": {
                "const": "monthly_or_presence"
              },
              "executor": {
                "const": "local_adapter"
              },
              "scope": {
                "const": "managed"
              },
              "unattended": {
                "const": "never"
              },
              "writes": {
                "const": [
                  "local_diagnostics",
                  "bounded_assessment"
                ]
              },
              "default_enabled": {
                "const": false
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "update-check"}}},
          "then": {
            "properties": {
              "category": {"const": "update"},
              "executor": {"const": "local_adapter"},
              "scope": {"const": "owner"},
              "unattended": {"const": "never"},
              "writes": {"const": ["source_custody", "candidate_plan", "local_diagnostics"]}
            }
          }
        },
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {
            "required": ["qualification_digest"],
            "properties": {"availability_reason": {"maxLength": 0}}
          },
          "else": {
            "properties": {"availability_reason": {"minLength": 1}},
            "not": {"required": ["qualification_digest"]}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"catalog_state": {"const": "catalog_only"}}},
      "then": {
        "properties": {
          "jobs": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/job"},
                {
                  "properties": {
                    "availability": {"const": "unavailable"},
                    "availability_reason": {"minLength": 1}
                  },
                  "not": {"required": ["qualification_digest"]}
                }
              ]
            }
          }
        }
      }
    }
  ]
}
