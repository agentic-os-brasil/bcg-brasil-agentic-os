{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1",
  "title": "Maestro SharePoint work catalog snapshot",
  "description": "Structural envelope. Cross-field root coverage, normalized uniqueness, composite conflicts, and the combined item/tombstone limit are enforced by the authoritative Go importer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "adapter_runtime",
    "tenant_ref",
    "mode",
    "collection_sequence",
    "generated_at",
    "watermark",
    "roots",
    "root_results",
    "items",
    "tombstones"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "sharepoint"},
    "adapter_runtime": {
      "const": "claude",
      "description": "Declared producer metadata only; it is not native runtime evidence or import authorization."
    },
    "tenant_ref": {"$ref": "#/$defs/opaque_ref"},
    "mode": {"enum": ["full", "delta"]},
    "collection_sequence": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "previous_watermark": {"$ref": "#/$defs/watermark"},
    "watermark": {"$ref": "#/$defs/watermark"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/root"},
      "uniqueItems": true
    },
    "root_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/root_result"},
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/item"}
    },
    "tombstones": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/tombstone"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"collection_sequence": {"const": 1}}, "required": ["collection_sequence"]},
      "then": {
        "properties": {"mode": {"const": "full"}},
        "not": {"required": ["previous_watermark"]}
      },
      "else": {"required": ["previous_watermark"]}
    }
  ],
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:!,-]{0,255}$"
    },
    "watermark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/+=-]{0,511}$"
    },
    "bounded_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]{0,254}[^\\s\\x00-\\x1F\\x7F])?$"
    },
    "facet_values": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/bounded_label"},
      "uniqueItems": true
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_ref", "drive_ref", "folder_ref"],
      "properties": {
        "site_ref": {"$ref": "#/$defs/opaque_ref"},
        "drive_ref": {"$ref": "#/$defs/opaque_ref"},
        "folder_ref": {"$ref": "#/$defs/opaque_ref"}
      }
    },
    "root_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "state"],
      "properties": {
        "root": {"$ref": "#/$defs/root"},
        "state": {"const": "complete"}
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clients", "projects", "themes", "years", "audiences", "people", "presenters"],
      "properties": {
        "clients": {"$ref": "#/$defs/facet_values"},
        "projects": {"$ref": "#/$defs/facet_values"},
        "themes": {"$ref": "#/$defs/facet_values"},
        "years": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "integer", "minimum": 1990, "maximum": 2200},
          "uniqueItems": true
        },
        "audiences": {"$ref": "#/$defs/facet_values"},
        "people": {"$ref": "#/$defs/facet_values"},
        "presenters": {"$ref": "#/$defs/facet_values"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "root",
        "kind",
        "name",
        "path_segments",
        "source_url",
        "created_at",
        "modified_at",
        "size_bytes",
        "media_type",
        "etag",
        "facets",
        "search_terms",
        "sensitivity",
        "status"
      ],
      "properties": {
        "item_ref": {"$ref": "#/$defs/opaque_ref"},
        "parent_ref": {"$ref": "#/$defs/opaque_ref"},
        "root": {"$ref": "#/$defs/root"},
        "kind": {"enum": ["folder", "file"]},
        "name": {"$ref": "#/$defs/bounded_label"},
        "path_segments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^/\\\\\\s\\x00-\\x1F\\x7F](?:[^/\\\\\\x00-\\x1F\\x7F]{0,254}[^/\\\\\\s\\x00-\\x1F\\x7F])?$"
          }
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:[A-Za-z0-9-]+\\.)*sharepoint\\.com(?:/[^?#]*)?$",
          "maxLength": 2048
        },
        "created_at": {"type": "string", "format": "date-time"},
        "modified_at": {"type": "string", "format": "date-time"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "etag": {"type": "string", "minLength": 1, "maxLength": 512},
        "facets": {"$ref": "#/$defs/facets"},
        "search_terms": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/bounded_label"},
          "uniqueItems": true
        },
        "sensitivity": {"enum": ["internal", "client_restricted"]},
        "status": {"const": "active"}
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "item_ref", "reason", "observed_at"],
      "properties": {
        "root": {"$ref": "#/$defs/root"},
        "item_ref": {"$ref": "#/$defs/opaque_ref"},
        "reason": {"enum": ["deleted", "access_revoked"]},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
