{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:maintenance-receipt:v1",
  "title": "BCG Brasil Agentic OS metadata-only maintenance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "occurrence_digest", "command_id", "job_id", "workspace_id", "trigger", "state", "recorded_at", "deadline", "proposal_only", "reason_code"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "occurrence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "trigger": {"enum": ["continuous", "event", "presence", "daily", "weekly", "monthly"]},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "state": {"enum": ["accepted", "busy", "succeeded", "reviewed_no_change", "recovery_required", "failed", "unavailable", "suppressed", "timed_out", "proposal_emitted"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "deadline": {"type": "string", "format": "date-time"},
    "proposal_only": {"type": "boolean"},
    "proposal_count": {"type": "integer", "minimum": 0},
    "proposal_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal_artifact_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recovery_phase": {"enum": ["intent", "completed", "failed", "audit_incomplete"]},
    "recovery_intent_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fence_token_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_code": {"enum": ["completed", "reviewed_no_change", "recovery_required", "recovery_intent", "recovery_completed", "recovery_failed", "recovery_committed_audit_incomplete", "proposal_emitted", "lease_busy", "handler_unavailable", "handler_failure", "deadline_exceeded", "catalog_unavailable", "authority_rejected", "occurrence_rejected", "receipt_persisted", "idle_state_unknown", "user_active", "failure_cooldown"]}
  },
  "allOf": [
    {
      "if": {"properties": {"trigger": {"enum": ["continuous", "event"]}}},
      "then": {"required": ["event_id"]},
      "else": {"not": {"required": ["event_id"]}}
    },
    {
      "if": {"properties": {"proposal_only": {"const": true}}},
      "then": {
        "properties": {"job_id": {"enum": ["darwin-structural-evolution-proposal", "yoda-self-review-weekly"]}},
        "not": {"properties": {"state": {"const": "succeeded"}}, "required": ["state"]}
      },
      "else": {
        "not": {
          "properties": {"job_id": {"enum": ["darwin-structural-evolution-proposal", "yoda-self-review-weekly"]}},
          "required": ["job_id"]
        }
      }
    },
    {
      "if": {"properties": {"job_id": {"const": "darwin-structural-evolution-proposal"}}, "required": ["job_id"]},
      "then": {"properties": {"proposal_only": {"const": true}, "trigger": {"const": "monthly"}}}
    },
    {
      "if": {"properties": {"job_id": {"const": "yoda-self-review-weekly"}}, "required": ["job_id"]},
      "then": {"properties": {"proposal_only": {"const": true}, "trigger": {"const": "weekly"}}}
    },
    {
      "if": {"properties": {"state": {"const": "proposal_emitted"}}},
      "then": {
        "required": ["proposal_count", "proposal_digest", "proposal_artifact_id"],
        "properties": {"proposal_count": {"type": "integer", "minimum": 1}}
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["proposal_count"]},
            {"required": ["proposal_digest"]},
            {"required": ["proposal_artifact_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"recovery_phase": {"const": "intent"}}, "required": ["recovery_phase"]},
      "then": {
        "required": ["recovery_intent_digest", "fence_token_digest"],
        "properties": {"reason_code": {"const": "recovery_intent"}}
      }
    },
    {
      "if": {"properties": {"recovery_phase": {"const": "completed"}}, "required": ["recovery_phase"]},
      "then": {
        "required": ["recovery_intent_digest", "fence_token_digest"],
        "properties": {"reason_code": {"const": "recovery_completed"}}
      }
    },
    {
      "if": {"properties": {"recovery_phase": {"const": "failed"}}, "required": ["recovery_phase"]},
      "then": {
        "required": ["recovery_intent_digest", "fence_token_digest"],
        "properties": {"reason_code": {"const": "recovery_failed"}}
      }
    },
    {
      "if": {"properties": {"recovery_phase": {"const": "audit_incomplete"}}, "required": ["recovery_phase"]},
      "then": {
        "required": ["recovery_intent_digest", "fence_token_digest"],
        "properties": {"reason_code": {"const": "recovery_committed_audit_incomplete"}}
      }
    },
    {
      "if": {"not": {"required": ["recovery_phase"]}},
      "then": {
        "not": {"anyOf": [
          {"required": ["recovery_intent_digest"]},
          {"required": ["fence_token_digest"]}
        ]}
      }
    }
  ]
}
