{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:darwin-self-receipt:v1",
  "title": "Darwin metadata-only owner-context self maintenance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","agent_id","snapshot_version","snapshot_sha256","observation_count","duplicate_count","contradiction_count","recheck_due","decay_candidates","owner_confirmed_signals","reevaluation_proposals","canonical_mutations","recorded_at"],
  "properties": {
    "schema_version": {"const": 1},
    "agent_id": {"const": "darwin"},
    "snapshot_version": {"type":"integer","minimum":1},
    "snapshot_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "observation_count": {"type":"integer","minimum":0},
    "duplicate_count": {"type":"integer","minimum":0},
    "contradiction_count": {"type":"integer","minimum":0},
    "recheck_due": {"type":"integer","minimum":0},
    "decay_candidates": {"type":"integer","minimum":0},
    "owner_confirmed_signals": {"type":"integer","minimum":0},
    "reevaluation_proposals": {"type":"integer","minimum":0},
    "canonical_mutations": {"const":0},
    "proposal_evidence_sha256": {"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "recorded_at": {"type":"string","format":"date-time"}
  }
}
