{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:scheduler-state:v1",
  "title": "BCG Brasil Agentic OS scheduler state",
  "oneOf": [
    {"$ref": "#/$defs/enrollment"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "enrolled_at"],
      "properties": {
        "schema_version": {"const": 1},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "enrolled_at": {"type": "string", "format": "date-time"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "job_id", "scheduled_for", "attempted_at", "state"],
      "properties": {
        "schema_version": {"const": 1},
        "workspace_id": {"$ref": "#/$defs/workspace_id"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "attempted_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["succeeded", "failed", "unavailable"]},
        "error": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "succeeded"}}},
          "then": {"not": {"required": ["error"]}},
          "else": {"required": ["error"]}
        }
      ]
    }
  }
}
