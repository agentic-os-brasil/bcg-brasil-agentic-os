{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-enrollment:v1",
  "title": "Maestro SharePoint work enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_ref",
    "purpose",
    "policy_version",
    "authorized_by",
    "enrolled_at",
    "authorization_expires_at",
    "scope_expansion_confirm_after",
    "refresh_hours",
    "stale_hours",
    "max_item_bytes",
    "max_snapshot_items",
    "allowed_item_types",
    "allowed_origins",
    "roots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tenant_ref": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/opaque_ref"},
    "purpose": {"const": "prior_work_retrieval"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "authorized_by": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/opaque_ref"},
    "enrolled_at": {"type": "string", "format": "date-time"},
    "authorization_expires_at": {"type": "string", "format": "date-time"},
    "scope_expansion_confirm_after": {"type": "string", "format": "date-time"},
    "refresh_hours": {"type": "integer", "minimum": 1, "maximum": 8760},
    "stale_hours": {"type": "integer", "minimum": 1, "maximum": 8760},
    "max_item_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "max_snapshot_items": {"type": "integer", "minimum": 1, "maximum": 100000},
    "allowed_item_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"enum": ["file", "folder"]},
      "uniqueItems": true
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^https://(?:[A-Za-z0-9-]+\\.)*sharepoint\\.com/?$"
      },
      "uniqueItems": true
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "urn:bcg-brasil-agentic-os:schema:sharepoint-work-catalog:v1#/$defs/root"},
      "uniqueItems": true
    }
  }
}
