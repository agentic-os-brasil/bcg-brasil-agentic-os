{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcgos.local/schemas/intent-review.schema.json",
  "title": "Runtime-neutral Walter intent review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_version", "literal_prompt", "literal_prompt_sha256", "maestro_plan", "maestro_plan_sha256", "draft_output", "draft_output_sha256", "user_self_snapshot", "audience", "consequence", "reversibility"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_version": {"type": "integer", "minimum": 1},
    "literal_prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
    "literal_prompt_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "maestro_plan": {"type": "string", "minLength": 1, "maxLength": 1000},
    "maestro_plan_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "draft_output": {"type": "string", "minLength": 1, "maxLength": 1000},
    "draft_output_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "relevant_context_refs": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "user_self_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "digest", "scope"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "execution-state.schema.json#/$defs/sha256"},
        "scope": {"const": "local_user"},
        "facet_digests": {"type": "object", "additionalProperties": {"$ref": "execution-state.schema.json#/$defs/sha256"}}
      }
    },
    "recent_observations": {"type": "array", "maxItems": 8, "items": {"type": "object"}},
    "audience": {"type": "string", "minLength": 1, "maxLength": 1000},
    "consequence": {"enum": ["low", "medium", "high"]},
    "reversibility": {"enum": ["reversible", "limited", "irreversible"]},
    "artifact_digest": {"$ref": "execution-state.schema.json#/$defs/sha256"},
    "account_validation_receipt_sha256": {"$ref": "execution-state.schema.json#/$defs/sha256"}
  }
}
