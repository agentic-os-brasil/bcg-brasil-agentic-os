# Local release exports are published as immutable GitHub Release assets.
# Keep the directory visible in the source tree without committing binaries.
/releases/*
!/releases/.gitkeep

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary files
*.tmp
*.bak
*.swp
